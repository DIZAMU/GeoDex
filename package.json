{
  "name": "geodex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Spaced-repetition geography trainer. Local-first PWA, English and Norwegian.",
  "author": "DIZAMU",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check . && node scripts/lint/no-dashes.ts",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:dashes": "node scripts/lint/no-dashes.ts",
    "data:fetch": "node --use-env-proxy scripts/data/fetch-wikidata.ts && node --use-env-proxy scripts/data/fetch-reference.ts",
    "data:build": "node scripts/data/build-countries.ts && node scripts/data/build-flags.ts",
    "data:verify": "node scripts/data/verify.ts"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "i18next": "26.4.4",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "6.1.2",
    "d3-geo": "3.1.1",
    "fake-indexeddb": "6.2.5",
    "flag-icons": "7.5.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "world-atlas": "2.0.2"
  }
}
