{
  // Cloudflare Worker serving the built app as static assets. Free tier, no server code.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geodex",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes (for example /atlas) return index.html.
    "not_found_handling": "single-page-application"
  },
  // Cloudflare builds a preview of every pull request branch with `wrangler preview`, which
  // needs this block. Previews take their settings from the top level.
  "previews": {}
}
